{
  "agent_servers": {
    "claude": {
      "default_mode": "plan"
    }
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "context_servers": {
    "browser-tools-context-server": {
      "enabled": true,
      "settings": {
        "port": 3025,
        "host": "127.0.0.1",
        "server_command": "npx",
        "server_args": ["@agentdeskai/browser-tools-server@1.2.0"]
      }
    },
    "mcp-server-context7": {
      "enabled": true,
      "settings": {}
    }
  },
  "agent": {
    "default_profile": "write",
    "profiles": {
      "ask-2": {
        "name": "Ask 2",
        "tools": {
          "diagnostics": true,
          "fetch": true,
          "list_directory": true,
          "project_notifications": false,
          "now": true,
          "find_path": true,
          "read_file": true,
          "open": true,
          "grep": true,
          "thinking": true,
          "web_search": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "always_allow_tool_actions": false,
    "model_parameters": []
  },
  "theme": "Gruvbox Dark",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "languages": {
    "Rust": {
      "tasks": {
        "variables": {
          "reveal": "no_focus"
        }
      },
      "inlay_hints": {
        "show_background": false,
        "enabled": true
      },
      "show_edit_predictions": false
    },
    "Scala": {
      "show_edit_predictions": false
    },
    "Python": {}
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "vertical_scroll_margin": 20,
  "ui_font_size": 16,
  "buffer_font_size": 14
}
