{
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "soft_wrap": "none",
  "preferred_line_length": 999999999,
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "context_servers": {
    "browser-tools-context-server": {
      "enabled": true,
      "settings": {
        "port": 3025,
        "host": "127.0.0.1",
        "server_command": "npx",
        "server_args": [
          "@agentdeskai/browser-tools-server@1.2.0"
        ]
      }
    },
    "mcp-server-context7": {
      "enabled": true,
      "settings": {}
    }
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "restore_file_from_disk": {
          "default": "allow"
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^ls\\b"
            },
            {
              "pattern": "^mkdir\\b"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^git\\s+add(\\s|$)"
            },
            {
              "pattern": "^git\\s+status(\\s|$)"
            }
          ]
        },
        "mcp:mcp-server-context7:query-docs": {
          "default_mode": "allow"
        }
      }
    },
    "default_profile": "write",
    "always_allow_tool_actions": false,
    "model_parameters": []
  },
  "theme": "Gruvbox Dark",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "languages": {
    "Markdown-Inline": {
      "inlay_hints": {
        "show_background": false,
        "enabled": true
      }
    },
    "Rust": {
      "tasks": {
        "variables": {
          "reveal": "no_focus"
        }
      },
      "inlay_hints": {
        "show_background": false,
        "enabled": true
      },
      "show_edit_predictions": false
    },
    "Scala": {
      "show_edit_predictions": false
    },
    "Python": {}
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "vertical_scroll_margin": 20,
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        },
        "cargo": {
          "allFeatures": true
        },
        "procMacro": {
          "enable": true
        }
      }
    }
  }
}
